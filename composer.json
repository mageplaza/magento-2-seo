{
    "name": "mageplaza/magento-2-seo-extension",
    "description": "Magento 2 SEO extension",
    "require": {
        "mageplaza/module-core": "^1.6.1"
    },
    "type": "magento2-module",
    "license": "proprietary",
    "keywords": [
        "magento 2",
        "mageplaza",
        "seo",
        "magento 2 seo"
    ],
    "authors": [
        {
            "name": "Mageplaza",
            "email": "support@mageplaza.com",
            "homepage": "https://www.mageplaza.com",
            "role": "Technical Support"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Mageplaza\\Seo\\": ""
        }
    },
    "version": "4.4.10",
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
