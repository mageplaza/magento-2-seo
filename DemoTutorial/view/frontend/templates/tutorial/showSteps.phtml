    <script type="text/javascript">
        require(['jquery', 'select20dom'], function ($) {
            $(document).ready(function () {
                const skippedKey = 'frontendTutorialSkipped';
                if (localStorage.getItem(skippedKey) === 'true') return;
                $('.sections.nav-sections').css('z-index', '1');
                $('.block.block-search').css('z-index', '1');
                const multiFlow = <?= json_encode($hasRegistered && $hasUnregistered) ?>;
                const allSteps = {
                    registered: <?= json_encode(array_values(array_map(function ($s) {
                        return [
                            'title' => $s['module_name'], 'content' => $s['content'], 'element' => $s['element'],
                            'url' => $s['page'], 'trigger' => $s['trigger'],
                            'position' => $s['notice_position'] ?? 'bottom'];
                    }, $stepsRegister))); ?>,
                    unregistered: <?= json_encode(array_values(array_map(function ($s) {
                        return [
                            'title' => $s['module_name'], 'content' => $s['content'], 'element' => $s['element'],
                            'url' => $s['page'], 'trigger' => $s['trigger'],
                            'position' => $s['notice_position'] ?? 'bottom'];
                    }, $stepsUnregister))); ?>
                };

                const stepKey = 'frontendTutorialStep';
                let steps = [];
                let currentStep = -1;
                let type = 'unregistered';

                function closeTutorial() {
                    localStorage.setItem(skippedKey, 'true');
                    $('#popup-container, #tutorial-overlay').fadeOut();
                    $('.tutorial-highlight').removeClass('tutorial-highlight');
                    $('.tutorial-tooltip').remove();
                }

                function showFirstPopup() {
                    if (localStorage.getItem(skippedKey) === 'true') return;
                    $('#tutorial-overlay, #popup-container, #tutorial-first-box').fadeIn();
                }

                function tooltipPos(offset, position, $tooltip, $target) {
                    switch (position) {
                        case 'top':
                            $tooltip.css({top: offset.top - $tooltip.outerHeight() - 30, left: offset.left});
                            break;
                        case 'right':
                            $tooltip.css({
                                top: offset.top + $target.outerHeight() / 2 - $tooltip.outerHeight() / 2,
                                left: offset.left + $target.outerWidth() + 30
                            });
                            break;
                        case 'left':
                            $tooltip.css({
                                top: offset.top + $target.outerHeight() / 2 - $tooltip.outerHeight() / 2,
                                left: offset.left - $tooltip.outerWidth() - 30
                            });
                            break;
                        default:
                            $tooltip.css({top: offset.top + $target.outerHeight() + 30, left: offset.left});
                    }
                }

                function renderTooltip(step, index) {
                    const $t = $('<div class="tutorial-tooltip"></div>');
                    $t.html(`<div class="content-title">${step.title}</div>
                             <div class="step-content">${step.content}</div>
                             <div class="tutorial-toolbar">
                                 <button class="skip-tutorial">Skip</button>
                                 <span id="step-counter">${index + 1} of ${steps.length}</span>
                                 <div>
                                     <button id="prev-step" ${index === 0 ? 'style="display:none;"' : ''}>Back</button>
                                     <button id="next-step" ${index === steps.length ? 'style="display:none;"' : ''}>Next</button>
                                 </div>
                             </div>`);
                    $('body').append($t);
                    return $t;
                }

                function handleTrigger(stp) {
                    if (stp.trigger && stp.trigger !== 'none') {
                        const $tg = $(stp.trigger);
                        if ($tg.length) {
                            if (stp.trigger === '.search input[type="text"]') {
                                $tg.focus()
                            } else if (stp.trigger === 'select#mpsearch-category'){
                                $tg.select2({
                                    minimumResultsForSearch: Infinity,
                                    templateResult: function (data) {
                                        if (!data.id) {
                                            return data.text;
                                        }

                                        var $option = $(data.element);
                                        if ($option.hasClass('parent-category')) {
                                            return $('<span style="font-weight: bold;">' + data.text + '</span>');
                                        }

                                        return data.text;
                                    }
                                });
                                $tg.select2('open');
                            }
                            else {
                                $tg.trigger('click');
                            }
                        }
                    }
                }

                function showStep(idx) {
                    if (idx < 0 || idx >= steps.length) return;
                    const stp = steps[idx];

                    if (window.location.pathname + window.location.search !== stp.url) {
                        localStorage.setItem(stepKey, idx);
                        window.location.href = stp.url;
                        return;
                    }

                    handleTrigger(stp);

                    $('.tutorial-highlight').removeClass('tutorial-highlight');
                    $('.tutorial-tooltip').remove();
                    const $target = $(stp.element);
                    if ($target.length) {
                        $target.addClass('tutorial-highlight');
                        $('html,body').animate({scrollTop: $target.offset().top - 150}, 500);
                    }

                    if ($target.find('.tutorial-overlay')) {
                        $('.tutorial-overlay').insertAfter($target);
                    }

                    const $tip = renderTooltip(stp, idx);

                    if ($target.length) {
                        $tip.addClass(stp.position || 'bottom');
                        tooltipPos($target.offset(), stp.position || 'bottom', $tip, $target);
                    } else {
                        if (stp.position === 'top') {
                            $tip.css({
                                top: $(window).scrollTop() + 20,
                                left: ($(window).width() - $tip.outerWidth()) / 2
                            });
                            $tip.addClass('bottom');
                        } else {
                            $tip.css({
                                top: $(window).scrollTop() + ($(window).height() - $tip.outerHeight()) / 2,
                                left: ($(window).width() - $tip.outerWidth()) / 2
                            });
                        }
                    }

                    $('#next-step').click((e) => {
                        if (steps[currentStep].trigger !== '.search input[type="text"]' && steps[currentStep].trigger !== 'select#mpsearch-category') {
                            handleTrigger(steps[currentStep]);
                        }
                        if (currentStep < steps.length - 1) {
                            currentStep++;
                            showStep(currentStep);
                            e.stopPropagation();
                            e.preventDefault();
                        } else {
                            $('.tutorial-tooltip').remove();
                            $('.tutorial-highlight').removeClass('tutorial-highlight');
                            $('#tutorial-end-box').fadeIn();
                            $('#tutorial-overlay').insertAfter('div#popup-container');
                        }
                    });

                    $('#prev-step').click((e) => {
                        if (steps[currentStep].trigger !== 'select#mpsearch-category' && steps[currentStep].trigger !== 'select#mpsearch-category') {
                            handleTrigger(steps[currentStep]);
                        }
                        if (currentStep > 0) {
                            currentStep--;
                            showStep(currentStep);
                            e.stopPropagation();
                            e.preventDefault();
                        }
                    });

                    $('div#paypal-smart-button').css({'position':'relative','z-index':'99'});
                    $('.skip-tutorial').click(closeTutorial);
                }

                // MULTI FLOW BUTTONS
                $('.start-flow').on('click', function () {
                    type = $(this).data('type');
                    steps = allSteps[type] || [];
                    currentStep = 0;
                    localStorage.setItem(stepKey, currentStep);
                    $('#tutorial-first-box').fadeOut(function () {
                        showStep(currentStep);
                    });
                    if (type === 'registered') { // handle demo auto-login
                        const formKey = $('.form-customer-login [name="form_key"]').val();
                        $.ajax({
                            url: window.location.origin + '/customer/ajax/login', type: 'POST',
                            data: JSON.stringify({
                                username: 'roni_cost@example.com',
                                password: 'roni_cost3@example.com',
                                form_key: formKey
                            }),
                            success: function (resp) {
                                $('#tutorial-first-box').fadeOut(function () {
                                    showStep(currentStep);
                                });
                            },
                            error: function () {
                                alert('Login failed.');
                            }
                        });
                    }
                });

                // SINGLE FLOW NEXT
                $('#start-tutorial').on('click', function () {
                    type = 'unregistered';
                    steps = allSteps[type] || [];
                    currentStep = 0;
                    localStorage.setItem(stepKey, currentStep);
                    $('#tutorial-first-box').fadeOut(function () {
                        showStep(currentStep);
                    });
                });

                // RESUME
                const savedStep = localStorage.getItem(stepKey);
                if (savedStep !== null) {
                    currentStep = parseInt(savedStep, 10);
                    type = multiFlow ? localStorage.getItem('tutorialFlow') || 'unregistered' : 'unregistered';
                    steps = allSteps[type] || [];
                    $('#tutorial-overlay,#popup-container').show();
                    showStep(currentStep);
                } else {
                    showFirstPopup();
                    $('.skip-tutorial').on('click', closeTutorial);
                }

                $('#prev-last-step').on('click', function () {
                    currentStep = steps.length - 1;
                    $('#tutorial-end-box').fadeOut(function () {
                        showStep(currentStep);
                    });
                });
            });
        });
    </script>

